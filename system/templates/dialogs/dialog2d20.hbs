<div class="fallout-dialog">
	<div class="flexrow">
		<div class="resource flexrow flex-group-left">
			<p class="title-label">
				{{localize "FALLOUT.TEMPLATES.Attribute"}}
			</p>
			<input
				data-dtype="Number"
				name="attribute"
				type="number"
				value="{{attribute}}"
			>
		</div>

		<div class="resource flexrow flex-group-left tile">
			<p class="title-label">
				{{localize "TYPES.Item.skill"}}
			</p>
			<input
				data-dtype="Number"
				name="skill"
				type="number"
				value="{{skill}}"
			>
		</div>

		<div class="resource flexrow flex-group-left green">
			<p class="title-label">
				{{localize "FALLOUT.TEMPLATES.Tag"}}
			</p>
			<input
				name="tag"
				type="checkbox"
				{{checked tag}}
			>
		</div>

		<div class="resource flexrow flex-group-left red">
			<p class="title-label">
				{{localize "FALLOUT.TEMPLATES.Compl"}}
			</p>
			<input
				data-dtype="Number"
				name="complication"
				type="number"
				value="{{complication}}"
			>
		</div>
	</div>
	<div class="flexrow" style="align-items: unset">
		<div class="resource flexcolumn flex-group-left">
			<h4>{{localize "FALLOUT.TEMPLATES.BUY_FROM_PARTY_AP"}}</h4>
			<p id="partyAP">{{localize "FALLOUT.TEMPLATE.AVALIABLE_PARTY_AP"}}:   {{partyAP}}</p>
			<div class="dicemodifiers" style=" display: flex; flex-direction: row; justify-content: space-around;">
				<a class="ap-btn ap-sub" data-action="modifyNumberOfDice" data-type = "remove">- {{localize "FALLOUT.TEMPLATES.REMOVE_DICE"}}</a>
            	<a class="ap-btn ap-add"  data-action="modifyNumberOfDice" data-type = "add">+{{localize "FALLOUT.TEMPLATES.ADD_DICE"}}</a>
			</div>
		</div>
		<div class="resource flexcolumn">
			<h4>{{localize "FALLOUT.TEMPLATES.DIFICULTY_LEVEL"}}</h4>
			<select name="dificulty" style="text-align: center; --input-text-color: black;">
                    {{selectOptions dificulty localize=true}}
            </select>
		</div>
	</div>
	<ul class="flexrow">
		<li>
			<a class="dice-icon d20" data-index="1" data-action="modifyNumberOfDice"  data-type = "dice">
				1
			</a>
		</li>
		<li>
			<a class="dice-icon d20 marked" data-index="2" data-action="modifyNumberOfDice" data-type = "dice">
				2
			</a>
		</li>
		<li>
			<a class="dice-icon d20" data-index="3" data-action="modifyNumberOfDice" data-type = "dice">
				3
			</a>
		</li>
		<li>
			<a class="dice-icon d20" data-index="4" data-action="modifyNumberOfDice" data-type = "dice">
				4
			</a>
		</li>
		<li>
			<a class="dice-icon d20" data-index="5" data-action="modifyNumberOfDice" data-type = "dice">
				5
			</a>
		</li>
	</ul>
</div>
<footer class="dialog-footer">
  <button type="button" data-action="roll" style="width:100%">{{localize "FALLOUT.UI.ROLL"}}</button>
</footer>
