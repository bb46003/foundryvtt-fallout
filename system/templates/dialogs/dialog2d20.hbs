<div class="fallout-dialog">
	<div class="flexrow">
		<div class="resource flexrow flex-group-left">
			<p class="title-label">
				{{localize "FALLOUT.TEMPLATES.Attribute"}}
			</p>
			<input
				data-dtype="Number"
				name="attribute"
				type="number"
				value="{{attribute}}"
			>
		</div>

		<div class="resource flexrow flex-group-left tile">
			<p class="title-label">
				{{localize "TYPES.Item.skill"}}
			</p>
			<input
				data-dtype="Number"
				name="skill"
				type="number"
				value="{{skill}}"
			>
		</div>

		<div class="resource flexrow flex-group-left green">
			<p class="title-label">
				{{localize "FALLOUT.TEMPLATES.Tag"}}
			</p>
			<input
				name="tag"
				type="checkbox"
				{{checked tag}}
			>
		</div>

		<div class="resource flexrow flex-group-left red">
			<p class="title-label">
				{{localize "FALLOUT.TEMPLATES.Compl"}}
			</p>
			<input
				data-dtype="Number"
				name="complicaction"
				type="number"
				value="{{complicaction}}"
			>
		</div>
	</div>

	<div class="flexrow unset-align">
		<div class="resource flexcolumn flex-group-left {{#if apDialog}}gm{{/if}}">
			{{#if isParty}}
			<h4>{{localize "FALLOUT.TEMPLATES.BUY_FROM_PARTY_AP"}}</h4>
			<p id="partyAP">{{localize "FALLOUT.TEMPLATE.AVALIABLE_PARTY_AP"}}:   {{partyAP}}</p>.
			{{/if}}
			{{#if isGM}}
				<h4>{{localize "FALLOUT.TEMPLATES.BUY_FROM_GM_AP"}}</h4>
				<p id="partyAP">{{localize "FALLOUT.TEMPLATE.AVALIABLE_GM_AP"}}:   {{gmAP}}</p>
			{{/if}}
			<p>
				{{localize "FALLOUT.TEMPLATE.FREED20"}}
				<input type="checkbox" id="freeD20" data-action="modifyNumberOfDice">
			</p>
			<div class="dicemodifiers">
				<a class="ap-btn ap-sub" {{#if apDialog}}data-action="dialogTypeAP"{{else}}data-action="modifyNumberOfDice"{{/if}} data-type="remove">
					- {{localize "FALLOUT.TEMPLATES.REMOVE_DICE"}}
				</a>
            	<a class="ap-btn ap-add" {{#if apDialog}}data-action="dialogTypeAP"{{else}}data-action="modifyNumberOfDice"{{/if}} data-type="add">
					+{{localize "FALLOUT.TEMPLATES.ADD_DICE"}}
				</a>
			</div>

		</div>

		<div class="resource flexcolumn">
			<h4>{{localize "FALLOUT.TEMPLATES.DIFICULTY_LEVEL"}}</h4>
			<select name="dificulty" class="difficulty-select">
                {{selectOptions dificulty localize=true}}
            </select>
		</div>
	</div>

	<ul class="flexrow">
		<li><a class="dice-icon d20" data-index="1" {{#if apDialog}}data-action="dialogTypeAP"{{else}}data-action="modifyNumberOfDice"{{/if}} data-type="dice">1</a></li>
		<li><a class="dice-icon d20 marked" data-index="2" {{#if apDialog}}data-action="dialogTypeAP"{{else}}data-action="modifyNumberOfDice"{{/if}} data-type="dice">2</a></li>
		<li><a class="dice-icon d20" data-index="3" {{#if apDialog}}data-action="dialogTypeAP"{{else}}data-action="modifyNumberOfDice"{{/if}} data-type="dice">3</a></li>
		<li><a class="dice-icon d20" data-index="4" {{#if apDialog}}data-action="dialogTypeAP"{{else}}data-action="modifyNumberOfDice"{{/if}} data-type="dice">4</a></li>
		<li><a class="dice-icon d20" data-index="5" {{#if apDialog}}data-action="dialogTypeAP"{{else}}data-action="modifyNumberOfDice"{{/if}} data-type="dice">5</a></li>
	</ul>
</div>

<footer class="dialog-footer">
  <button type="button" data-action="roll" class="roll-btn">{{localize "FALLOUT.UI.ROLL"}}</button>
</footer>
